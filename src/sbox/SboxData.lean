import Std

/- Two published 4-bit S-boxes from Rønjom, Sandrib and Sunde (2026).
   Source commit: 7fe4f154ef64279ca5ba6b2bf9d4735c7a74dd0f.
   No claims about full-cipher security or global S-box optimality. -/
set_option maxRecDepth 200000
set_option maxHeartbeats 0

namespace Sbox

abbrev Word := BitVec 4
abbrev Counts := Word → Word → Nat

def words : List Word := (List.finRange 16).map (fun x => BitVec.ofNat 4 x.val)

/-- Number of all 16 input values x giving output difference b for input difference a. -/
def differenceCount (f : Word → Word) (a b : Word) : Nat :=
  words.countP (fun x => (f x ^^^ f (x ^^^ a)) == b)

abbrev ValidBasis (u v : Word) : Prop := u ≠ 0 ∧ v ≠ 0 ∧ u ≠ v

/-- Structural insertion sort: fully reducible by the kernel, with no well-founded machinery. -/
def insertWord (x : Word) : List Word → List Word
  | [] => [x]
  | y :: ys => if x.toNat ≤ y.toNat then x :: y :: ys else y :: insertWord x ys

def sortWords : List Word → List Word
  | [] => []
  | x :: xs => insertWord x (sortWords xs)

/-- All four points of the binary affine plane, in canonical increasing order. -/
def plane (a u v : Word) : List Word :=
  sortWords [a, a ^^^ u, a ^^^ v, a ^^^ u ^^^ v]

/-- Aggregate the full difference table over two planes, omitting zero input difference. -/
def scoreFromCounts (D : Counts) (A B : List Word) : Nat :=
  A.foldl (fun total a => if a == 0 then total else
    total + B.foldl (fun subtotal b => subtotal + D a b) 0) 0

def score (f : Word → Word) (A B : List Word) : Nat :=
  scoreFromCounts (differenceCount f) A B

