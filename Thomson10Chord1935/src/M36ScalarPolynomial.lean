def L : ℚ := 387 / 200
def quadraticShift : ℚ := 149769 / 80000

def hCompositionPowerCoefficient (j : ℕ) : ℚ :=
  ∑ i : Fin 13, if j ≤ i.val then
    hCoefficient i * (Nat.choose i.val j : ℚ) * (-quadraticShift) ^ j
    else 0

def kernelPowerCoefficient (k : ℕ) : ℚ :=
  if k = 0 then 1 else if k % 2 = 1 then
    -L * hCompositionPowerCoefficient ((k - 1) / 2) else 0

def bernsteinProductPowerCoefficient (k i j : ℕ) : ℚ :=
  if i + j ≤ k ∧ k ≤ 24 then
    (Nat.choose 12 i : ℚ) * (Nat.choose 12 j : ℚ) *
      (Nat.choose (24 - i - j) (k - i - j) : ℚ) *
        (-1 : ℚ) ^ (k - i - j)
  else 0

def minorantPowerCoefficient (A : Fin 13 → Fin 13 → ℚ) (k : ℕ) : ℚ :=
  ∑ i : Fin 13, ∑ j : Fin 13,
    A i j * bernsteinProductPowerCoefficient k i.val j.val

def residualPowerCoefficient (k : ℕ) : ℚ :=
  ∑ i : Fin 26, if i.val ≤ k ∧ k ≤ 25 then
    residualBernsteinCoefficient i * (Nat.choose 25 i.val : ℚ) *
      (Nat.choose (25 - i.val) (k - i.val) : ℚ) *
        (-1 : ℚ) ^ (k - i.val)
    else 0

def certificatePowerCoefficient (k : ℕ) : ℚ :=
  (if 0 < k then L * minorantPowerCoefficient minorantSCoefficient (k - 1) else 0) +
    L * (minorantPowerCoefficient minorantTwoMinusSCoefficient k -
      if 0 < k then minorantPowerCoefficient minorantTwoMinusSCoefficient (k - 1) else 0) +
    residualPowerCoefficient k

theorem actual_scalar_coefficient_identity :
    ∀ k : Fin 26, kernelPowerCoefficient k.val = certificatePowerCoefficient k.val := by
  intro k
  fin_cases k <;> decide +kernel

def scalarKernelPowerBasis : Fin 26 → ℚ := fun k ↦ kernelPowerCoefficient k.val
def scalarCertificatePowerBasis : Fin 26 → ℚ := fun k ↦ certificatePowerCoefficient k.val

theorem actual_scalar_polynomial_identity :
    scalarKernelPowerBasis = scalarCertificatePowerBasis := by
  funext k
  exact actual_scalar_coefficient_identity k

#print axioms actual_scalar_coefficient_identity
#print axioms actual_scalar_polynomial_identity
end Thomson10M36ScalarPolynomial
