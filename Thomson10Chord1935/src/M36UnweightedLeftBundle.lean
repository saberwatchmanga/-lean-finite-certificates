theorem leftRowsLength : ∀ i : Fin 84, (leftRows.getD i.val []).length = 84 := by decide +kernel
def leftVector (i k : Fin 84) : ℤ := M36UnweightedLeftColumns.vectorFromList (leftRows.getD i.val []) (leftRowsLength i) k
def rightVector (j k : Fin 84) : ℤ := M36UnweightedLeftColumns.rightVector j k
def savedProduct (i j : Fin 84) : ℤ := (savedRows.getD i.val []).getD j.val 0
theorem shared_columns_match : M36UnweightedLeftColumns.rightColumns = rightColumns := by rfl
theorem left_rows_ofFn : ∀ i : Fin 84, List.ofFn (leftVector i) = leftRows.getD i.val [] := by
  intro i
  exact M36UnweightedLeftColumns.vectorFromList_ofFn
    (leftRows.getD i.val []) (leftRowsLength i)

theorem right_columns_ofFn : ∀ j : Fin 84, List.ofFn (rightVector j) = rightColumns.getD j.val [] := by
  intro j
  change List.ofFn (M36UnweightedLeftColumns.rightVector j) = rightColumns.getD j.val []
  rw [← shared_columns_match]
  exact M36UnweightedLeftColumns.right_columns_ofFn j
