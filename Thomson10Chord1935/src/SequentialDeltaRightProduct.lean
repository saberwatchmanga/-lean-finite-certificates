def shiftedVector (i k : Fin 35) : ℤ := (shiftedRows.getD i.val []).getD k.val 0
def preconditionerVector (j k : Fin 35) : ℤ := (preconditionerColumns.getD j.val []).getD k.val 0
def savedProduct (i j : Fin 35) : ℤ := (savedProductRows.getD i.val []).getD j.val 0
theorem shifted_rows_ofFn : ∀ i : Fin 35, List.ofFn (shiftedVector i) = shiftedRows.getD i.val [] := by decide +kernel
theorem preconditioner_columns_ofFn : ∀ j : Fin 35, List.ofFn (preconditionerVector j) = preconditionerColumns.getD j.val [] := by decide +kernel
theorem all_sequential_products : ∀ i j : Fin 35,
    sequentialDot (shiftedRows.getD i.val []) (preconditionerColumns.getD j.val []) = savedProduct i j := by decide +kernel
theorem all_finite_products : ∀ i j : Fin 35,
    (∑ k : Fin 35, shiftedVector i k * preconditionerVector j k) = savedProduct i j := by
  intro i j
  rw [←sequentialDot_to_finite_sum 35 (shiftedRows.getD i.val [])
    (preconditionerColumns.getD j.val []) (shiftedVector i) (preconditionerVector j)
    (shifted_rows_ofFn i) (preconditioner_columns_ofFn j)]
  exact all_sequential_products i j
