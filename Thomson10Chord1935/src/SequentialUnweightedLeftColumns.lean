def vectorFromList {n : ℕ} (xs : List ℤ) (hlen : xs.length = n) (i : Fin n) : ℤ := xs.get (Fin.cast hlen.symm i)
theorem vectorFromList_ofFn {n : ℕ} (xs : List ℤ) (hlen : xs.length = n) :
    List.ofFn (fun i : Fin n => vectorFromList xs hlen i) = xs := by
  cases hlen
  simp [vectorFromList]
theorem rightRowsLength : ∀ j : Fin 84, (rightColumns.getD j.val []).length = 84 := by decide +kernel
def rightVector (j k : Fin 84) : ℤ := vectorFromList (rightColumns.getD j.val []) (rightRowsLength j) k
theorem right_columns_ofFn : ∀ j : Fin 84, List.ofFn (rightVector j) = rightColumns.getD j.val [] := by
  intro j
  exact vectorFromList_ofFn _ (rightRowsLength j)
#print axioms vectorFromList_ofFn
#print axioms rightRowsLength
#print axioms right_columns_ofFn
end Thomson10SequentialUnweightedLeftColumns
