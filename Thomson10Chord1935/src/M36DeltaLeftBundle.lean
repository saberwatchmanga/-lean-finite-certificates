theorem leftRowsLength : ∀ i : Fin 35, (leftRows.getD i.val []).length = 35 := by decide +kernel
def leftVector (i k : Fin 35) : ℤ := M36DeltaLeftColumns.vectorFromList (leftRows.getD i.val []) (leftRowsLength i) k
def rightVector (j k : Fin 35) : ℤ := M36DeltaLeftColumns.rightVector j k
def savedProduct (i j : Fin 35) : ℤ := (savedRows.getD i.val []).getD j.val 0
theorem shared_columns_match : M36DeltaLeftColumns.rightColumns = rightColumns := by rfl
theorem left_rows_ofFn : ∀ i : Fin 35, List.ofFn (leftVector i) = leftRows.getD i.val [] := by
  intro i
  exact M36DeltaLeftColumns.vectorFromList_ofFn
    (leftRows.getD i.val []) (leftRowsLength i)

theorem right_columns_ofFn : ∀ j : Fin 35, List.ofFn (rightVector j) = rightColumns.getD j.val [] := by
  intro j
  change List.ofFn (M36DeltaLeftColumns.rightVector j) = rightColumns.getD j.val []
  rw [← shared_columns_match]
  exact M36DeltaLeftColumns.right_columns_ofFn j
