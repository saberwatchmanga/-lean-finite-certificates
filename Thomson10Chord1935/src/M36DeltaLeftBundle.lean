  · change sequentialDot (leftRows.getD 32 []) (rightColumns.getD j.val []) = (savedRows.getD 32 []).getD j.val 0
    rw [← shared_columns_match]
    exact M36DeltaLeftChunk00.product_row_32 j
  · change sequentialDot (leftRows.getD 33 []) (rightColumns.getD j.val []) = (savedRows.getD 33 []).getD j.val 0
    rw [← shared_columns_match]
    exact M36DeltaLeftChunk00.product_row_33 j
  · change sequentialDot (leftRows.getD 34 []) (rightColumns.getD j.val []) = (savedRows.getD 34 []).getD j.val 0
    rw [← shared_columns_match]
    exact M36DeltaLeftChunk00.product_row_34 j
theorem all_finite_products : ∀ i j : Fin 35,
    (∑ k : Fin 35, leftVector i k * rightVector j k) = savedProduct i j := by
  intro i j
  rw [← sequentialDot_to_finite_sum 35 (leftRows.getD i.val []) (rightColumns.getD j.val [])
    (leftVector i) (rightVector j) (left_rows_ofFn i) (right_columns_ofFn j)]
  exact all_sequential_products i j
