theorem leftRowsLength : ∀ i : Fin 56, (leftRows.getD i.val []).length = 56 := by decide +kernel
def leftVector (i k : Fin 56) : ℤ := M36WeightedLeftColumns.vectorFromList (leftRows.getD i.val []) (leftRowsLength i) k
def rightVector (j k : Fin 56) : ℤ := M36WeightedLeftColumns.rightVector j k
def savedProduct (i j : Fin 56) : ℤ := (savedRows.getD i.val []).getD j.val 0
theorem shared_columns_match : M36WeightedLeftColumns.rightColumns = rightColumns := by rfl
theorem left_rows_ofFn : ∀ i : Fin 56, List.ofFn (leftVector i) = leftRows.getD i.val [] := by
  intro i
  exact M36WeightedLeftColumns.vectorFromList_ofFn
    (leftRows.getD i.val []) (leftRowsLength i)

theorem right_columns_ofFn : ∀ j : Fin 56, List.ofFn (rightVector j) = rightColumns.getD j.val [] := by
  intro j
  change List.ofFn (M36WeightedLeftColumns.rightVector j) = rightColumns.getD j.val []
  rw [← shared_columns_match]
  exact M36WeightedLeftColumns.right_columns_ofFn j
