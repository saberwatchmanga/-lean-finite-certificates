theorem actual_coefficient_by_index (j : Fin 455) :
  coefficient actualUnweightedIntegerPolynomial (coefficientExponents.getD j.val (0,0,0))=mergedCoefficients.getD j.val 0 := by
  have hlen : j.val<coefficientExponents.length := by rw [coefficient_exponents_length];exact j.isLt
  have hrow : ∀ i : Fin 84,coefficient (rowPolynomial i) (coefficientExponents.getD j.val (0,0,0))=(expectedRows.getD i.val []).getD j.val 0 := by
    intro i
    rw [←all_actual_row_coefficients i]
    exact (map_getD_in_bounds coefficientExponents (coefficient (rowPolynomial i)) (0,0,0) 0 j.val hlen).symm
  have hcoef : coefficient actualUnweightedIntegerPolynomial (coefficientExponents.getD j.val (0,0,0))=∑ i : Fin 84,coefficient (rowPolynomial i) (coefficientExponents.getD j.val (0,0,0)) := by
    exact coefficient_flatten_ofFn 84 (fun i=>rowPolynomial i) _
  rw [hcoef]
  simp_rw [hrow]
  have hs := getD_sumCoefficientRows expectedRows j.val
  rw [numeric_integer_merge] at hs
  have hm : (expectedRows.map (fun p=>p.getD j.val 0)).sum=∑ i : Fin 84,(expectedRows.getD i.val []).getD j.val 0 := by
    have hp := congrArg (fun ps : List (List ℤ)=>(ps.map (fun p=>p.getD j.val 0)).sum) expected_rows_ofFn
    simpa only [List.map_ofFn,integer_sum_ofFn,Function.comp_apply] using hp.symm
  rw [hm] at hs
  exact hs.symm
#print axioms actual_coefficient_by_index
end Thomson10UnweightedSparseMerge
