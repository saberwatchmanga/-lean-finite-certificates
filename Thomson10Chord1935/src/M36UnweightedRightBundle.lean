theorem all_finite_products : ∀ i j : Fin 84,
    (∑ k : Fin 84, leftVector i k * rightVector j k) = savedProduct i j := by
  intro i j
  rw [← sequentialDot_to_finite_sum 84 (leftRows.getD i.val []) (rightColumns.getD j.val [])
    (leftVector i) (rightVector j) (left_rows_ofFn i) (right_columns_ofFn j)]
  exact all_sequential_products i j
