def leftVector (i k : Fin 56) : ℤ := (leftRows.getD i.val []).getD k.val 0
def rightVector (j k : Fin 56) : ℤ := (rightColumns.getD j.val []).getD k.val 0
def savedProduct (i j : Fin 56) : ℤ := (savedRows.getD i.val []).getD j.val 0
theorem left_rows_ofFn : ∀ i : Fin 56, List.ofFn (leftVector i) = leftRows.getD i.val [] := by decide +kernel
theorem right_columns_ofFn : ∀ j : Fin 56, List.ofFn (rightVector j) = rightColumns.getD j.val [] := by decide +kernel
theorem all_sequential_products : ∀ i j : Fin 56,
    sequentialDot (leftRows.getD i.val []) (rightColumns.getD j.val []) = savedProduct i j := by decide +kernel
theorem all_finite_products : ∀ i j : Fin 56,
    (∑ k : Fin 56, leftVector i k * rightVector j k) = savedProduct i j := by
  intro i j
  rw [←sequentialDot_to_finite_sum 56 (leftRows.getD i.val [])
    (rightColumns.getD j.val []) (leftVector i) (rightVector j)
    (left_rows_ofFn i) (right_columns_ofFn j)]
  exact all_sequential_products i j
#print axioms left_rows_ofFn
#print axioms right_columns_ofFn
#print axioms all_sequential_products
#print axioms all_finite_products
end Thomson10SequentialWeightedRightProduct
