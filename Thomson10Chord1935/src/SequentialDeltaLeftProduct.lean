def savedCongruence (i j : Fin 35) : ℤ := (savedCongruenceRows.getD i.val []).getD j.val 0
theorem left_factor_rows_ofFn : ∀ i : Fin 35,
    List.ofFn (preconditionerVector i) = preconditionerColumns.getD i.val [] := by
