theorem inverse_right_rat : ∀ i j,
    (∑ k : Fin 17, coordinateChangeRat i k * coordinateInverseRat k j) =
      if i=j then (1 : Rat) else 0 := by
  intro i
  fin_cases i <;> decide +kernel

theorem inverse_left_rat : ∀ i j,
    (∑ k : Fin 17, coordinateInverseRat i k * coordinateChangeRat k j) =
      if i=j then (1 : Rat) else 0 := by
  intro i
  fin_cases i <;> decide +kernel

def coordinateChange (i j : Fin 17) : ℝ := coordinateChangeRat i j
def coordinateInverse (i j : Fin 17) : ℝ := coordinateInverseRat i j

theorem inverse_right_real (i j : Fin 17) :
    (∑ k : Fin 17, coordinateChange i k * coordinateInverse k j) =
      if i=j then (1 : ℝ) else 0 := by
  have hr := congrArg (fun q : Rat => (q : ℝ)) (inverse_right_rat i j)
  by_cases h : i = j <;> simpa [coordinateChange, coordinateInverse, h] using hr

theorem inverse_left_real (i j : Fin 17) :
    (∑ k : Fin 17, coordinateInverse i k * coordinateChange k j) =
      if i=j then (1 : ℝ) else 0 := by
  have hr := congrArg (fun q : Rat => (q : ℝ)) (inverse_left_rat i j)
  by_cases h : i = j <;> simpa [coordinateChange, coordinateInverse, h] using hr

def applyMatrix (A : Fin 17 → Fin 17 → ℝ) (x : Fin 17 → ℝ) (i : Fin 17) : ℝ :=
  ∑ j, A i j * x j

theorem apply_inverse_product (A B : Fin 17 → Fin 17 → ℝ)
    (hab : ∀ i j, (∑ k : Fin 17, A i k * B k j) = if i=j then 1 else 0)
    (x : Fin 17 → ℝ) : applyMatrix A (applyMatrix B x) = x := by
  funext i
  unfold applyMatrix
  simp only [Finset.mul_sum]
  rw [Finset.sum_comm]
  simp only [← mul_assoc, ← Finset.sum_mul, hab]
  simp

theorem coordinate_change_bijective : Function.Bijective (applyMatrix coordinateChange) := by
  have hleft := apply_inverse_product coordinateInverse coordinateChange inverse_left_real
  have hright := apply_inverse_product coordinateChange coordinateInverse inverse_right_real
  constructor
  · intro x y hxy
    calc
      x = applyMatrix coordinateInverse (applyMatrix coordinateChange x) := (hleft x).symm
      _ = applyMatrix coordinateInverse (applyMatrix coordinateChange y) := congrArg _ hxy
      _ = y := hleft y
  · intro y
    exact ⟨applyMatrix coordinateInverse y, hright y⟩

